# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ถูก ignore ไว้แล้ว)

# จำเป็น — API key จาก Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# โมเดลที่ใช้ (เปลี่ยนได้โดยไม่ต้องแก้โค้ด)
# gemini-flash-latest = alias ที่ชี้ไปยัง Flash รุ่นล่าสุดเสมอ จึงไม่หมดอายุ
# ทางเลือกอื่น: gemini-3.6-flash (เร็วกว่า), gemini-3.1-flash-lite (เร็วที่สุด ราคาถูกที่สุด)
# ห้ามใช้ gemini-2.5-flash — Google ปิดรับผู้ใช้ใหม่แล้ว จะได้ 404
GEMINI_MODEL=gemini-flash-latest

# พอร์ตของ API
API_PORT=3001

# origin ของ Frontend ที่อนุญาตให้เรียก (คั่นด้วย , ถ้ามีหลายอัน)
WEB_ORIGIN=http://localhost:3000

# เวลารอ AI สูงสุด (มิลลิวินาที)
AI_TIMEOUT_MS=30000

# ความสร้างสรรค์ของโมเดล 0 = คงที่ที่สุด เหมาะกับงานแก้ข้อความ
AI_TEMPERATURE=0.2

# จำกัดจำนวนครั้งต่อ IP: THROTTLE_LIMIT ครั้ง ต่อ THROTTLE_TTL_MS มิลลิวินาที
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=20
